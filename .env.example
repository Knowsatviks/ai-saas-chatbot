# Required for chat and memory features
GEMINI_API_KEY=your_gemini_api_key

# Change these before using the app outside local development
JWT_SECRET=replace_with_a_long_random_secret
COOKIE_SECRET=replace_with_a_long_random_secret

# Optional MongoDB override; the default uses the Compose mongo service
MONGODB_URL=mongodb://mongo:27017/chatbot

# Optional SMTP settings for password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=