# Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real secrets

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
# Local development: http://localhost:5173
# Production (Render): https://<your-frontend-url>
FRONTEND_URL=http://localhost:5173

# Database Configuration
# Local: mongodb://localhost:27017/chatbot
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp
MONGODB_URL=mongodb://localhost:27017/chatbot

# Authentication Secrets (use strong random strings in production)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_change_in_production
COOKIE_SECRET=your_cookie_secret_here_change_in_production

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ORGANIZATION_ID=your_gemini_org_id_here

# Memory/Embedding Configuration (optional, defaults provided)
MEMORY_EMBEDDING_MODEL=text-embedding-004
MEMORY_VECTOR_INDEX_NAME=memory_vector_index

# Email Configuration (for password reset)
# Using Gmail: generate App Password in Google Account settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM="App Name <your_email@gmail.com>"
